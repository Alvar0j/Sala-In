{
  "name": "sala-in-web",
  "version": "0.1.0",
  "private": true,
  "description": "Control web de la sala inmersiva: demos con QLab (OSC) y WATCHOUT 7 (HTTP).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "mock:qlab": "node tools/mock-qlab.js",
    "mock:watchout": "node tools/mock-watchout.js",
    "test": "node --test test/*.test.js"
  }
}
