<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Arranca la web de Sala-In al iniciar sesión en el Mac y la reinicia si se cierra.
  1. Cambia RUTA_AL_REPO por la carpeta donde está el repositorio (p. ej. /Users/sala/Sala-In).
  2. Comprueba la ruta de node con `which node` (Homebrew en Apple Silicon: /opt/homebrew/bin/node).
  3. cp deploy/es.rmsproaudio.salain.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/es.rmsproaudio.salain.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>es.rmsproaudio.salain</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>RUTA_AL_REPO/web/src/server.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key><string>8080</string>
  </dict>
  <key>WorkingDirectory</key><string>RUTA_AL_REPO/web</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/salain.log</string>
  <key>StandardErrorPath</key><string>/tmp/salain.log</string>
</dict>
</plist>
